terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  alias  = "primary"
  region = var.primary_region
}
{% if is_multi_region %}

provider "aws" {
  alias  = "secondary"
  region = var.secondary_region
}
{% endif %}
