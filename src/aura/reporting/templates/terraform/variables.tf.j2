# Generated by `aura terraform generate` from candidate "{{ candidate_id }}"
# ({{ candidate_name }}) for workload "{{ workload_name }}". Regenerate
# instead of hand-editing if the AURA recommendation changes for this
# workload — see terraform/README.md "Generated environments".

variable "primary_region" {
  type    = string
  default = "{{ primary_region }}"
}
{% if is_multi_region %}

variable "secondary_region" {
  type    = string
  default = "{{ secondary_region }}"
}
{% endif %}

variable "environment" {
  description = "Distinguishes this from a real production deployment; used in resource names/tags."
  type        = string
  default     = "demo"
}

variable "container_image" {
  description = "Placeholder demo application image. Replace with the real application image before this is anything more than a demo."
  type        = string
  default     = "public.ecr.aws/nginx/nginx:1.27"
}

variable "database_instance_class" {
  type    = string
  default = "db.t3.micro"
}

# {{ primary_desired_count }} is what {{ "%.0f" | format(peak_rps) }} peak RPS
# actually needs at {{ "%.0f" | format(rps_per_task) }} RPS/task (the same
# math the cost engine uses) — not a demo-friendly number. Override with
# `-var primary_desired_count=3` (etc.) for a deployable demo; the default
# here is the honest, traceable one.
variable "primary_desired_count" {
  type    = number
  default = {{ primary_desired_count }}
}
{% if is_multi_region %}

variable "secondary_desired_count" {
  type    = number
  default = {{ secondary_desired_count }}
}
{% endif %}
