# Generated by `aura terraform generate` from candidate "{{ candidate_id }}"
# ({{ candidate_name }}) for workload "{{ workload_name }}", peak
# {{ "%.0f" | format(peak_rps) }} RPS. This topology mirrors
# src/aura/architecture/generator.py exactly — see build_terraform_context()
# in src/aura/reporting/terraform_codegen.py for the derivation. Regenerate
# rather than hand-edit if the AURA recommendation for this workload changes.
{% if has_cdn_or_router %}
#
# NOTE: this candidate's topology also declares a global-router/cdn
# component. Neither is generated here — both need a registered domain,
# which this generator has no way to know about. See terraform/README.md.
{% endif %}

data "aws_availability_zones" "primary" {
  provider = aws.primary
  state    = "available"
}
{% if is_multi_region %}

data "aws_availability_zones" "secondary" {
  provider = aws.secondary
  state    = "available"
}
{% endif %}

locals {
  name_prefix = "aura-${var.environment}"

  primary_azs = slice(data.aws_availability_zones.primary.names, 0, {{ primary_az_count }})
{% if is_multi_region %}
  secondary_azs = slice(data.aws_availability_zones.secondary.names, 0, {{ secondary_az_count }})
{% endif %}

  common_tags = {
    Project      = "AURA"
    Environment  = var.environment
    ManagedBy    = "terraform"
    Architecture = "{{ candidate_id }}"
  }
}

module "network_primary" {
  source = "../../modules/networking"
  providers = {
    aws = aws.primary
  }

  name               = "${local.name_prefix}-primary"
  vpc_cidr           = "10.0.0.0/16"
  availability_zones = local.primary_azs
  enable_nat_gateway = true
  tags               = local.common_tags
}
{% if is_multi_region %}

module "network_secondary" {
  source = "../../modules/networking"
  providers = {
    aws = aws.secondary
  }

  name               = "${local.name_prefix}-secondary"
  vpc_cidr           = "10.1.0.0/16"
  availability_zones = local.secondary_azs
  enable_nat_gateway = true
  tags               = local.common_tags
}
{% endif %}
{% if has_queue %}

module "queue" {
  source = "../../modules/queue"
  providers = {
    aws = aws.primary
  }

  name = "${local.name_prefix}-queue"
  tags = local.common_tags
}
{% endif %}

module "compute_primary" {
  source = "../../modules/compute"
  providers = {
    aws = aws.primary
  }

  name               = "${local.name_prefix}-primary"
  vpc_id             = module.network_primary.vpc_id
  public_subnet_ids  = module.network_primary.public_subnet_ids
  private_subnet_ids = module.network_primary.private_subnet_ids
  container_image    = var.container_image
  desired_count      = var.primary_desired_count
{% if has_queue %}
  has_sqs_queue      = true
  sqs_queue_arn      = module.queue.queue_arn
  sqs_queue_url      = module.queue.queue_url
{% endif %}
  tags               = local.common_tags
}
{% if is_multi_region %}

# secondary_desired_count's default reflects this pattern's actual
# secondary-region capacity ratio, computed from the same topology the cost
# engine uses — 0 means AURA modelled no standing compute there (a
# cold/pilot-light secondary), not a mistake.
module "compute_secondary" {
  source = "../../modules/compute"
  providers = {
    aws = aws.secondary
  }

  name               = "${local.name_prefix}-secondary"
  vpc_id             = module.network_secondary.vpc_id
  public_subnet_ids  = module.network_secondary.public_subnet_ids
  private_subnet_ids = module.network_secondary.private_subnet_ids
  container_image    = var.container_image
  desired_count      = var.secondary_desired_count
  tags               = local.common_tags
}
{% endif %}
{% if has_cache %}

module "cache_primary" {
  source = "../../modules/cache"
  providers = {
    aws = aws.primary
  }

  name                        = "${local.name_prefix}-primary"
  vpc_id                      = module.network_primary.vpc_id
  private_subnet_ids          = module.network_primary.private_subnet_ids
  allowed_security_group_ids  = [module.compute_primary.service_security_group_id]
  tags                        = local.common_tags
}
{% endif %}
{% if has_secondary_cache %}

module "cache_secondary" {
  source = "../../modules/cache"
  providers = {
    aws = aws.secondary
  }

  name                        = "${local.name_prefix}-secondary"
  vpc_id                      = module.network_secondary.vpc_id
  private_subnet_ids          = module.network_secondary.private_subnet_ids
  allowed_security_group_ids  = [module.compute_secondary.service_security_group_id]
  tags                        = local.common_tags
}
{% endif %}
{% if is_multi_region %}

# Cross-region RDS read replicas need a KMS key local to the destination
# region (a source region's key cannot encrypt data at rest in another
# region).
resource "aws_kms_key" "database_replica" {
  provider    = aws.secondary
  description = "Encrypts the ${local.name_prefix} cross-region RDS read replica"
  tags        = local.common_tags
}
{% endif %}

module "database_primary" {
  source = "../../modules/database"
  providers = {
    aws = aws.primary
  }

  name                       = "${local.name_prefix}-primary"
  vpc_id                     = module.network_primary.vpc_id
  private_subnet_ids         = module.network_primary.private_subnet_ids
  allowed_security_group_ids = [module.compute_primary.service_security_group_id]
  instance_class             = var.database_instance_class
  multi_az                   = true
  tags                       = local.common_tags
}
{% if is_multi_region %}

module "database_secondary" {
  source = "../../modules/database"
  providers = {
    aws = aws.secondary
  }

  name                       = "${local.name_prefix}-secondary"
  vpc_id                     = module.network_secondary.vpc_id
  private_subnet_ids         = module.network_secondary.private_subnet_ids
  allowed_security_group_ids = [module.compute_secondary.service_security_group_id]
  instance_class             = var.database_instance_class
  replicate_source_db        = module.database_primary.arn
  kms_key_id                 = aws_kms_key.database_replica.arn
  is_replica                 = true
  multi_az                   = {{ "true" if database_multi_az_secondary else "false" }}
  tags                       = local.common_tags
}
{% endif %}
